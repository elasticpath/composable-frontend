{
  "name": "@epcc-sdk/payments",
  "version": "0.5.0",
  "description": "",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.ts",
  "scripts": {
    "build": "pnpm oas:build && pnpm openapi-ts && pnpm build:tsup",
    "build:tsup": "tsup",
    "oas:build": "redocly bundle payments-standalone@v1 --config ../specs/config/redocly.yaml",
    "openapi-ts": "openapi-ts",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.mjs"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./zod": {
      "import": {
        "types": "./dist/zod.d.ts",
        "default": "./dist/zod.mjs"
      },
      "require": {
        "types": "./dist/zod.d.cts",
        "default": "./dist/zod.cjs"
      }
    },
    "./mcp": {
      "import": {
        "types": "./dist/mcp.d.ts",
        "default": "./dist/mcp.mjs"
      },
      "require": {
        "types": "./dist/mcp.d.cts",
        "default": "./dist/mcp.cjs"
      }
    },
    "./package.json": "./package.json"
  },
  "typesVersions": {
    "*": {
      "zod": [
        "./dist/zod.d.ts"
      ],
      "mcp": [
        "./dist/mcp.d.ts"
      ]
    }
  },
  "files": [
    "dist/**"
  ],
  "keywords": [],
  "publishConfig": {
    "access": "public"
  },
  "dependencies": {
    "@epcc-sdk/sdks-runtime": "workspace:*"
  },
  "devDependencies": {
    "@hey-api/openapi-ts": "0.99.0",
    "@modelcontextprotocol/client": "2.3.1",
    "@modelcontextprotocol/server": "2.3.1",
    "@redocly/cli": "^1.21.0",
    "@redocly/openapi-core": "^1.21.0",
    "@types/ejs": "^3.1.5",
    "ejs": "^3.1.10",
    "esbuild-fix-imports-plugin": "^1.0.19",
    "esbuild-plugin-file-path-extensions": "^1.0.0",
    "tsup": "^8.4.0",
    "typescript": "^5.5.3",
    "vitest": "^3.0.7",
    "zod": "4.6.5"
  },
  "peerDependencies": {
    "@modelcontextprotocol/server": "^2",
    "zod": "^4.0.0"
  },
  "peerDependenciesMeta": {
    "@modelcontextprotocol/server": {
      "optional": true
    },
    "zod": {
      "optional": true
    }
  }
}
