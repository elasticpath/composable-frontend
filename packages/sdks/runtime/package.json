{
  "name": "@epcc-sdk/sdks-runtime",
  "version": "0.0.0",
  "description": "Service-agnostic runtime helpers for the Elastic Path generated SDKs: token providers, storage adapters, a caching token source, a retry wrapper with backoff, and a client factory that wires them together.",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.ts",
  "scripts": {
    "build": "pnpm build:tsup",
    "build:tsup": "tsup",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.mjs"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./retry": {
      "import": {
        "types": "./dist/retry.d.ts",
        "default": "./dist/retry.mjs"
      },
      "require": {
        "types": "./dist/retry.d.cts",
        "default": "./dist/retry.cjs"
      }
    },
    "./package.json": "./package.json"
  },
  "typesVersions": {
    "*": {
      "retry": ["./dist/retry.d.ts"]
    }
  },
  "files": [
    "dist/**"
  ],
  "keywords": [
    "elastic-path",
    "oauth",
    "authentication",
    "client-credentials",
    "retry",
    "backoff"
  ],
  "publishConfig": {
    "access": "public"
  },
  "dependencies": {
    "@epcc-sdk/authentication": "workspace:*"
  },
  "devDependencies": {
    "esbuild-fix-imports-plugin": "^1.0.19",
    "esbuild-plugin-file-path-extensions": "^1.0.0",
    "tsup": "^8.4.0",
    "typescript": "^5.5.3",
    "vitest": "^3.0.7"
  }
}
