{
  "name": "@epcc-sdk/sdks-runtime",
  "version": "0.1.0",
  "description": "Service-agnostic runtime helpers for the Elastic Path generated SDKs: token providers, storage adapters, a caching token source, a retry wrapper with backoff, a client factory that wires them together, and MCP endpoint tools built from a package's operations.",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.ts",
  "scripts": {
    "build": "pnpm build:tsup",
    "build:tsup": "tsup",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.mjs"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./retry": {
      "import": {
        "types": "./dist/retry.d.ts",
        "default": "./dist/retry.mjs"
      },
      "require": {
        "types": "./dist/retry.d.cts",
        "default": "./dist/retry.cjs"
      }
    },
    "./mcp": {
      "import": {
        "types": "./dist/mcp/index.d.ts",
        "default": "./dist/mcp/index.mjs"
      },
      "require": {
        "types": "./dist/mcp/index.d.cts",
        "default": "./dist/mcp/index.cjs"
      }
    },
    "./package.json": "./package.json"
  },
  "typesVersions": {
    "*": {
      "retry": [
        "./dist/retry.d.ts"
      ],
      "mcp": [
        "./dist/mcp/index.d.ts"
      ]
    }
  },
  "files": [
    "dist/**"
  ],
  "keywords": [
    "elastic-path",
    "oauth",
    "authentication",
    "client-credentials",
    "retry",
    "backoff",
    "mcp"
  ],
  "publishConfig": {
    "access": "public"
  },
  "dependencies": {
    "@epcc-sdk/authentication": "workspace:*"
  },
  "devDependencies": {
    "@modelcontextprotocol/sdk": "1.31.0",
    "ajv": "8.20.0",
    "ajv-formats": "3.0.1",
    "esbuild-fix-imports-plugin": "^1.0.19",
    "esbuild-plugin-file-path-extensions": "^1.0.0",
    "tsup": "^8.4.0",
    "typescript": "^5.5.3",
    "vitest": "^3.0.7",
    "zod": "4.6.5"
  },
  "peerDependencies": {
    "@modelcontextprotocol/sdk": "^1.31.0",
    "zod": "^4.0.0"
  },
  "peerDependenciesMeta": {
    "@modelcontextprotocol/sdk": {
      "optional": true
    },
    "zod": {
      "optional": true
    }
  }
}
