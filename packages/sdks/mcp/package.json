{
  "name": "@epcc-sdk/sdks-mcp",
  "version": "0.0.0",
  "description": "Register the MCP endpoint tools that the Elastic Path generated SDKs export on an MCP server.",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.ts",
  "scripts": {
    "build": "pnpm build:tsup",
    "build:tsup": "tsup",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.mjs"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist/**"
  ],
  "keywords": [
    "elastic-path",
    "mcp",
    "model-context-protocol"
  ],
  "publishConfig": {
    "access": "public"
  },
  "devDependencies": {
    "@modelcontextprotocol/sdk": "1.31.0",
    "esbuild-fix-imports-plugin": "^1.0.19",
    "tsup": "^8.4.0",
    "typescript": "^5.5.3",
    "vitest": "^3.0.7",
    "zod": "4.6.5"
  },
  "peerDependencies": {
    "@modelcontextprotocol/sdk": "^1.31.0",
    "zod": "^4.0.0"
  },
  "peerDependenciesMeta": {
    "@modelcontextprotocol/sdk": {
      "optional": true
    },
    "zod": {
      "optional": true
    }
  }
}
