{
  "name": "@epcc-sdk/sdks-authentication-realms",
  "version": "0.2.0",
  "description": "",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.ts",
  "scripts": {
    "build": "pnpm oas:build && pnpm openapi-ts && pnpm build:tsup",
    "oas:build": "redocly bundle authentication-realms-standalone@v1 --config ../specs/config/redocly.yaml",
    "build:tsup": "tsup",
    "openapi-ts": "openapi-ts"
  },
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.mjs"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./zod": {
      "import": {
        "types": "./dist/zod.d.ts",
        "default": "./dist/zod.mjs"
      },
      "require": {
        "types": "./dist/zod.d.cts",
        "default": "./dist/zod.cjs"
      }
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist/**"
  ],
  "keywords": [],
  "publishConfig": {
    "access": "public"
  },
  "dependencies": {
    "@epcc-sdk/sdks-runtime": "workspace:*"
  },
  "devDependencies": {
    "@hey-api/openapi-ts": "0.99.0",
    "@redocly/cli": "^1.21.0",
    "@redocly/openapi-core": "^1.21.0",
    "@types/ejs": "^3.1.5",
    "ejs": "^3.1.10",
    "esbuild-fix-imports-plugin": "^1.0.19",
    "esbuild-plugin-file-path-extensions": "^1.0.0",
    "tsup": "^8.4.0",
    "typescript": "^5.5.3",
    "zod": "3.25.76"
  }
}
