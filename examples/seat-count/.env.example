# The store this example talks to. Use the absolute URL, with https://.
NEXT_PUBLIC_EPCC_ENDPOINT_URL=https://euwest.api.elasticpath.com

# Client id of a store API key. The example only asks for an implicit
# (shopper) token with it; no secret is needed or read.
NEXT_PUBLIC_EPCC_CLIENT_ID=

# Where shoppers go for orders above a product's seat limit: an http(s) URL
# or a mailto: address. Read on the server at request time.
CUSTOMER_SERVICE_URL=mailto:sales@example.com
