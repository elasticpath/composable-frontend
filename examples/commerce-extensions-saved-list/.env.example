# The store this example talks to.
NEXT_PUBLIC_EPCC_ENDPOINT_URL=https://euwest.api.elasticpath.com

# Implicit (read-only) key. This one reaches the browser, so it has no secret.
NEXT_PUBLIC_EPCC_CLIENT_ID=

# Password profile shoppers sign in against.
NEXT_PUBLIC_PASSWORD_PROFILE_ID=

# Server-only key used for saved list writes. An implicit token cannot write a
# Custom API Entry. No NEXT_PUBLIC_ prefix: these must never reach the browser.
EPCC_CLIENT_ID=
EPCC_CLIENT_SECRET=


# Admin credentials for `pnpm provision` are NOT set here. Pass them in your
# shell, once, when you provision the store:
#   EP_ENDPOINT_URL=... EP_ADMIN_CLIENT_ID=... EP_ADMIN_CLIENT_SECRET=... pnpm provision
